# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Query limit per day (default: 100)
DAILY_LIMIT=100

# Comma-separated list of allowed CORS origins (default: https://trymagi.tech)
CORS_ORIGINS=https://trymagi.tech,https://www.trymagi.tech

# Runtime environment — set to "production" on the droplet
NODE_ENV=production

# Debug endpoint — set to "true" to enable /api/debug/last
ENABLE_DEBUG_ENDPOINT=false

# Token required to access /api/debug/last when enabled (min 32 chars)
DEBUG_TOKEN=
